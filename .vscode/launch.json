      "program": "${workspaceFolder}\\src\\predict.py",
      "args": ["--image", "data\\demo\\test\\cats\\cat_00.png", "--model", "models\\cats_dogs_cnn.npz"],
      "console": "integratedTerminal"
    }
  ]
}
