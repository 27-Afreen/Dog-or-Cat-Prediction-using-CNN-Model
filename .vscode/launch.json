{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train CNN",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\train.py",
      "args": ["--data-dir", "data\\demo", "--model", "models\\cats_dogs_cnn.npz", "--epochs", "12"],
      "console": "integratedTerminal"
